        (string=? f "id") (option-some-of [:option :string] "spcr.renaming-1994-add-transport")
        (string=? f "title") (option-some-of [:option :string] "General assembly approved renaming to Svaz průmyslu a dopravy České republiky (Confederation of Industry AND TRANSPORT), expanding scope (Czech Wikipedia)")
        (string=? f "association") (option-some-of [:option :string] "spcr")
