(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0)
      2
      (= i 1)
      2
      (= i 2)
      1
      (= i 3)
      2
      (= i 4)
      2
      (= i 5)
      1
      (= i 6)
      2
      (= i 7)
      2
      (= i 8)
      2
      (= i 9)
      2
      (= i 10)
      2
      (= i 11)
      2
      (= i 12)
      2
      (= i 13)
      1
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
  (cond
    (= i 0)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      (= t 1) (option-some-of [:option :string] "history")
      :else (option-none-of [:option :string]))
    (= i 1)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      (= t 1) (option-some-of [:option :string] "history")
      :else (option-none-of [:option :string]))
    (= i 2)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 3)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      (= t 1) (option-some-of [:option :string] "labour-law")
      :else (option-none-of [:option :string]))
    (= i 4)
    (cond
      (= t 0) (option-some-of [:option :string] "social-dialogue")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 5)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 6)
    (cond
      (= t 0) (option-some-of [:option :string] "ethics")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 7)
    (cond
      (= t 0) (option-some-of [:option :string] "membership")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 8)
    (cond
      (= t 0) (option-some-of [:option :string] "elections")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 9)
    (cond
      (= t 0) (option-some-of [:option :string] "economic-policy")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 10)
    (cond
      (= t 0) (option-some-of [:option :string] "trade-promotion")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 11)
    (cond
      (= t 0) (option-some-of [:option :string] "history")
      (= t 1) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 12)
    (cond
      (= t 0) (option-some-of [:option :string] "economic-policy")
      (= t 1) (option-some-of [:option :string] "eu-affairs")
      :else (option-none-of [:option :string]))
    (= i 13)
    (cond
      (= t 0) (option-some-of [:option :string] "economic-policy")
      :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "governance") 12
      (string=? candidate "history") 3
      (string=? candidate "labour-law") 1
      (string=? candidate "social-dialogue") 1
      (string=? candidate "ethics") 1
      (string=? candidate "membership") 1
      (string=? candidate "elections") 1
      (string=? candidate "economic-policy") 3
      (string=? candidate "trade-promotion") 1
      (string=? candidate "eu-affairs") 1
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (cond
        (string=? candidate "governance") (option-some-of [:option :string] "spcr.founding-1990")
        (string=? candidate "history") (option-some-of [:option :string] "spcr.founding-1990")
        (string=? candidate "labour-law") (option-some-of [:option :string] "spcr.employers-organisation-legal-basis")
        (string=? candidate "social-dialogue") (option-some-of [:option :string] "spcr.tripartite-social-dialogue")
        (string=? candidate "ethics") (option-some-of [:option :string] "spcr.ethics-code-2021")
        (string=? candidate "membership") (option-some-of [:option :string] "spcr.payment-rules-2026")
        (string=? candidate "elections") (option-some-of [:option :string] "spcr.candidate-nomination-rules-2026")
        (string=? candidate "economic-policy") (option-some-of [:option :string] "spcr.programme-declaration-2026")
        (string=? candidate "trade-promotion") (option-some-of [:option :string] "spcr.trade-fair-committee-statutes")
        (string=? candidate "eu-affairs") (option-some-of [:option :string] "spcr.eu-priorities-2024-2029")
        :else (option-none-of [:option :string]))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-9411-cze-spcr (ADR-2607141700): 14 spcr entries, each with a citation that was fetched. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
